rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Configuração do admin - apenas admin autenticado pode escrever
    match /config/{document} {
      // Qualquer um pode ler (para ver se a loja está aberta, preços, etc)
      allow read: if true;

      // Apenas admin autenticado pode escrever
      allow write: if request.auth != null;
    }

    // Pedidos - clientes podem criar, admin pode ler/atualizar/deletar
    match /orders/{orderId} {
      // Qualquer um pode criar um pedido (clientes não logados)
      allow create: if true;

      // Apenas admin autenticado pode ler, atualizar e deletar
      allow read, update, delete: if request.auth != null;
    }

    // Produtos - qualquer um pode ler, apenas admin pode modificar
    match /products/{productId} {
      // Qualquer um pode ler (para ver o catálogo)
      allow read: if true;

      // Apenas admin autenticado pode criar, atualizar e deletar
      allow create, update, delete: if request.auth != null;
    }

    // Bloqueia acesso a qualquer outra coleção
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
